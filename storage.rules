rules_version = '2';

// Firebase Storage rules — separate system from firestore.rules, deployed
// separately (Console → Storage → Rules, same copy-paste flow as the
// Firestore ones). Storage rules can't cross-reference Firestore documents
// (no equivalent of Firestore rules' get()/exists() against another
// service), so ownership here is enforced purely by path: every upload
// lives under users/{uid}/..., and only that uid may write there. Every
// upload path in utils/storage.js follows this shape.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      // Photos/videos are shown to other users (feed, profiles, stories),
      // so any signed-in user can read — same read policy as the Firestore
      // rules for reviews/stories/profiles.
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
    }
  }
}
